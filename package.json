    "test:noise": "tsx scripts/test-noise-cleanup.ts",
    "test:boundaries": "tsx scripts/test-region-boundaries.ts",
    "test:strokes": "tsx scripts/test-contour-strokes.ts",
    "test:geometry": "tsx scripts/test-geometric-precision.ts",
    "test:gradients": "tsx scripts/test-gradient-color.ts",
    "test:e2e": "tsx scripts/test-e2e-browser-inkscape.ts",
